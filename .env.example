# ==============================================================================
# MY PERSONAL PORTFOLIO – ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Netlify (Frontend) + Supabase (Database, Auth, Storage, Edge Functions)
# Owner: SUBAIR MOHAMED SUHITH | Digital Creator & Entrepreneur
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to `.env.local` for local development.
# 2. Add client-safe variables (prefixed with VITE_) to Netlify Dashboard:
#    Site configuration -> Environment variables.
# 3. Add server secrets to Supabase Edge Function Secrets (via Supabase Dashboard or CLI).
# 4. NEVER commit `.env` or sensitive production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SAFE ENVIRONMENT VARIABLES (Netlify & Vite Frontend)
# ------------------------------------------------------------------------------
# Production site URL (or custom domain once configured in Netlify)
VITE_SITE_URL=https://your-site-name.netlify.app

# Default localization language (en = English, ta = Tamil, si = Sinhala)
VITE_DEFAULT_LANGUAGE=en

# Public WhatsApp contact number (international format without '+', e.g. 94771234567)
VITE_WHATSAPP_NUMBER=94700000000
VITE_WHATSAPP_DEFAULT_MESSAGE="Hello Subair, I visited your portfolio website and would like to connect."

# Supabase Public API Connection (Client Browser Safe)
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://<YOUR-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR-SUPABASE-ANON-KEY>

# Optional Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Supabase Edge Functions ONLY - NEVER IN NETLIFY FRONTEND)
# ------------------------------------------------------------------------------
# Configure via: `supabase secrets set KEY=VALUE` or in Supabase Dashboard

# Supabase Service Role Key (Server-only bypass key, NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=<YOUR-SUPABASE-SERVICE-ROLE-KEY>

# Meta WhatsApp Business Cloud API Credentials
# Obtain from: Meta for Developers -> WhatsApp -> API Setup & WhatsApp Manager
WHATSAPP_ACCESS_TOKEN=<YOUR-META-SYSTEM-USER-PERMANENT-ACCESS-TOKEN>
WHATSAPP_PHONE_NUMBER_ID=<YOUR-META-WHATSAPP-PHONE-NUMBER-ID>
WHATSAPP_BUSINESS_ACCOUNT_ID=<YOUR-META-WABA-ID>
WHATSAPP_OTP_TEMPLATE_NAME=auth_otp_verification
WHATSAPP_API_VERSION=v21.0

# Cryptographic Salt for OTP Hashing (Generate a random 64-character hex string)
OTP_SALT_SECRET=<GENERATE-A-RANDOM-64-CHARACTER-HEX-STRING>

# ------------------------------------------------------------------------------
# 3. ALTERNATIVE BACKUP PROVIDER (Twilio - Optional)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
